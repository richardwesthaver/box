;;; baseline.box --- Baseline Archiso config -*- mode:skel -*-
:type :archiso
:target :x64
:hostname "baseline"
:iso-name "archlinux"
:iso-label "ARCH_$(date --date=\"@${SOURCE_DATE_EPOCH:-$(date +%s)}\" +%Y%m)"
:iso-publisher "Arch Linux <https://archlinux.org>"
:iso-application "Arch Linux Live/Rescue DVD"
:iso-version "$(date --date=\"@${SOURCE_DATE_EPOCH:-$(date +%s)}\" +%Y.%m.%d)"
:airootfs "/usr/share/archiso/configs/baseline/airootfs/"
:install-dir "arch"
:buildmodes (:iso)
:bootmodes (:bios.syslinux :uefi.systemd-boot)
:pacman-conf #P"/usr/share/archiso/configs/baseline/pacman.conf"
:airootfs-image-type "squashfs"
:airootfs-image-tool-options ("-comp" "xz" "-Xbcj" "x86" "-b" "1M"
                              "-Xdict-size" "1M")
:bootstrap-tarball-compression ("zstd" "-c" "-T0" "--auto-threads=logical"
                                "--long" "-19")
:file-permissions (("/etc/shadow" . "0:0:400"))
:bootstrap-packages (arch-install-scripts base)
:packages
(base
 cloud-init
 hyperv
 linux
 mkinitcpio
 mkinitcpio-archiso
 open-vm-tools
 openssh
 pv
 qemu-guest-agent
 syslinux
 virtualbox-guest-utils-nox)
