;;; core.box --- Core Archiso Config -*- mode:skel -*-

;; This box is the stage0 Core Linux baseline. All CORE runtime
;; dependencies are supplied to support running the CORE as PID0
;; (init)
:type :archiso
:hostname "coreiso"
:iso-name "coreiso"
:iso-publisher "The Compiler Company <https://compiler.company>"
:iso-application "Core Linux Live/Rescue DVD"
:iso-version "$(date --date=\"@${SOURCE_DATE_EPOCH:-$(date +%s)}\" +%Y.%m.%d)"
:install-dir "arch"
:buildmodes (:iso)
:bootmodes (:bios.syslinux :uefi.systemd-boot)
:airootfs "rootfs/"
:airootfs-image-type "squashfs"
:airootfs-image-tool-options 
("-comp" "xz" "-Xbcj" "x86" "-b" "1M" "-Xdict-size" "1M")
:bootstrap-tarball-compression 
("zstd" "-c" "-T0" "--auto-threads=logical" "--long" "-19")
:file-permissions
(("/etc/shadow" . "0:0:400")
 ("/root" . "0:0:750")
 ("/root/.gnupg" . "0:0:700"))
:pacman-conf #P"/usr/share/archiso/configs/baseline/pacman.conf"
:bootstrap-packages (arch-install-scripts base)
:packages 
(base linux linux-atm linux-firmware
 amd-ucode intel-ucode ldns less
 syslinux sudo xdg-utils openssh 
 mkinitcpio mkinitcpio-archiso iw iwd
 cloud-init btrfs-progs efibootmgr kitty-terminfo
 tmux vim xdg-utils xfsprogs 
 squashfs-tools lftp hyperv nbd
 nmap nvme-cli open-iscsi man-db
 man-pages lvm2 gptfdisk edk2-shell
 dhcpcd dmraid dnsmasq dosfstools
 dmidecode archinstall arch-install-scripts cryptsetup
 e2fsprogs ethtool exfatprogs f2fs-tools 
 gpm memtest86+-efi nfs-utils)

