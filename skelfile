;;; box @ 2025-03-13.00:47:53 -*- mode:skel; -*-
:name "box"
:author ("Richard Westhaver" . "ells@rwest.io")
:author "Richard Westhaver"
:version "0.2.0"
:vc (:hg "https://vc.compiler.company/infra/box")
:components 
((:box "baseline")
 (:box "releng")
 (:box "coreiso")
 (:box "webiso")
 (:box "worker"))
:rules 
((arm (alarm edk2-arm))
 (alarm ()
  "https://gist.github.com/robertkirkman/f79441c79811ad263f2f881f7864e793"
  (req:fetch "https://fl.us.mirror.archlinuxarm.org/os/ArchLinuxARM-aarch64-latest.tar.gz" 
   ".stash/alarm-aarch64.tar.gz"))
 (edk2-arm ()
  (req:fetch "https://github.com/retrage/edk2-nightly/raw/refs/heads/master/bin/RELEASEAARCH64_QEMU_EFI.fd"
   ".stash/AARCH64_QEMU_EFI.fd"))
 (baseline ()
  ;; (component ...)
  (build (obj:load-config :archiso #p"baseline.box") :path ".stash/baseline")
  (with-sudo
   "mkarchiso -v -o .stash/out -w .stash/baseline/work .stash/baseline"))
 (releng ()
  ;; (component ...)
  (build (obj:load-config :archiso #p"releng.box") :path ".stash/releng")
  (with-sudo
   "mkarchiso -v -o .stash/out -w .stash/releng/work .stash/releng"))
 (run-arch ()
  (run-archiso (namestring (car (directory-files ".stash/out/archlinux")))))
 (coreiso ()
  ;; (component ...)
  (build (obj:load-config :archiso #p"coreiso.box") :path ".stash/coreiso")
  ;; provision rootfs..
  ;; arch-chroot - default passwords, cloud-init, users, home config
  (with-sudo
   "mkarchiso -v -o .stash/out -w .stash/coreiso/work .stash/coreiso"))
 (run-coreiso ()
  (run-archiso (namestring (car (directory-files ".stash/out/coreiso"))))))

